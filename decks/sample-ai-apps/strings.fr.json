    "s5.M.sh149.p1": { "text": "© Copyright Microsoft Corporation. Tous droits réservés.", "src": "eb8425d5" },
    "s5.sh5.p1": { "text": "Microsoft Foundry", "src": "ccb80b4a" },
    "s5.sh131.p1": { "text": "Une plateforme unifiée pour les applications et les agents d’IA", "src": "04c0dca1" },
    "s5.sh130.p1": { "text": "Les <i>ressources</i> Foundry dans Azure fournissent des services de calcul, de stockage, de mise à disposition de modèles et d’autres services", "src": "def6826b" },
    "s5.sh130.p2": { "text": "Les <i>projets</i> Foundry sont des environnements de travail isolés pour le développement d’applications et d’agents", "src": "7d9928ca" },
    "s5.sh130.p3": { "text": "Dans un projet, vous travaillez avec :", "src": "63a267fe" },
    "s5.sh130.p4": { "text": "<b>Modèles</b> – choisissez et déployez des modèles à partir d’un vaste catalogue", "src": "4c53e53a" },
    "s5.sh130.p5": { "text": "<b>Agents</b> – créez et gérez des agents qui utilisent des modèles pour le traitement du langage et le raisonnement", "src": "0ff8d083" },
    "s5.sh130.p6": { "text": "<b>Outils</b> – connectez les agents à des outils pour leur permettre d’effectuer des actions et d’accéder à des informations", "src": "7eac46a1" },
    "s5.sh130.p7": { "text": "<b>Connaissances</b> – gérez l’accès des agents aux sources de données afin qu’ils disposent des informations nécessaires pour agir", "src": "f1e79bfc" },
    "s5.sh83.p1": { "text": "", "src": "d642d845" },
