    "s5.sh3.p1": { "text": "© Copyright Microsoft Corporation. Tous droits réservés.", "src": "eb8425d5" },
    "s5.notes.p1": { "text": "Définissez Foundry en une phrase : « Foundry vous offre un espace de travail organisé en projets pour créer des applications et des agents d’IA, avec des modèles, des outils et des connaissances réunis au même endroit. »", "src": "d82646c3" },
    "s5.notes.p2": { "text": "Insistez sur le modèle conceptuel : les <b>ressources</b> fournissent des services de calcul, de stockage et de mise à disposition de modèles.", "src": "55564b5c" },
    "s5.notes.p3": { "text": "Les <b>projets</b> sont des environnements de travail isolés pour le développement d’applications &amp; d’agents.", "src": "8e58c919" },
    "s5.notes.p4": { "text": "Au sein des projets : <b>modèles</b>, <b>agents</b>, <b>outils</b>, <b>connaissances</b>.", "src": "4d6ec164" },
    "s5.notes.p5": { "text": "Repère pratique : « Lorsque les apprenants se sentent perdus, revenez à ce schéma : la plupart des tâches se rattachent à l’une de ces quatre catégories. »", "src": "54027b8d" }
  }
