    "s5.sh126.p1": { "text": "<i>Recurso</i> de Microsoft Foundry", "src": "cb67db2f" },
    "s5.sh127.p1": { "text": "<i>Proyecto</i> de Microsoft Foundry", "src": "c5276194" },
    "s5.sh3.p1": { "text": "© Copyright Microsoft Corporation. Todos los derechos reservados.", "src": "eb8425d5" },
    "s5.notes.p1": { "text": "Define Foundry en una frase: «Foundry te ofrece un espacio de trabajo basado en proyectos para crear aplicaciones y agentes de IA con modelos, herramientas y conocimiento en un solo lugar».", "src": "d82646c3" },
    "s5.notes.p2": { "text": "Destaca el modelo conceptual: los <b>recursos</b> proporcionan servicios de cómputo, almacenamiento y suministro de modelos.", "src": "55564b5c" },
    "s5.notes.p3": { "text": "Los <b>proyectos</b> son entornos de trabajo aislados para desarrollar aplicaciones y agentes.", "src": "8e58c919" },
    "s5.notes.p4": { "text": "Dentro de los proyectos: <b>Modelos</b>, <b>Agentes</b>, <b>Herramientas</b>, <b>Conocimiento</b>.", "src": "4d6ec164" },
    "s5.notes.p5": { "text": "Enfoque práctico: «Cuando los participantes se sientan perdidos, vuelve a mostrarles esta imagen: la mayoría de las tareas corresponden a una de estas cuatro categorías».", "src": "54027b8d" }
