    "s5.M.sh149.p1": { "text": "© Copyright Microsoft Corporation. Todos los derechos reservados.", "src": "eb8425d5" },
    "s5.sh5.p1": { "text": "Microsoft Foundry", "src": "ccb80b4a" },
    "s5.sh131.p1": { "text": "Una plataforma unificada para aplicaciones y agentes de IA", "src": "04c0dca1" },
    "s5.sh130.p1": { "text": "Los <i>recursos</i> de Foundry en Azure proporcionan capacidad de procesamiento, almacenamiento, distribución de modelos y otros servicios", "src": "def6826b" },
    "s5.sh130.p2": { "text": "Los <i>proyectos</i> de Foundry son entornos de trabajo aislados para desarrollar aplicaciones y agentes", "src": "7d9928ca" },
    "s5.sh130.p3": { "text": "En un proyecto, trabajas con:", "src": "63a267fe" },
    "s5.sh130.p4": { "text": "<b>Modelos</b> – elige e implementa modelos de un amplio catálogo", "src": "4c53e53a" },
    "s5.sh130.p5": { "text": "<b>Agentes</b> – crea y administra agentes que utilizan modelos para tareas de lenguaje y razonamiento", "src": "0ff8d083" },
    "s5.sh130.p6": { "text": "<b>Herramientas</b> – conecta los agentes a herramientas para que puedan realizar acciones y acceder a información", "src": "7eac46a1" },
    "s5.sh130.p7": { "text": "<b>Conocimiento</b> – administra el acceso de los agentes a las fuentes de datos para que dispongan de la información que necesitan para actuar", "src": "f1e79bfc" },
    "s5.sh83.p1": { "text": "", "src": "d642d845" },
