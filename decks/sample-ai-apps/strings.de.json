    "s5.M.sh149.p1": { "text": "© Copyright Microsoft Corporation. Alle Rechte vorbehalten.", "src": "eb8425d5" },
    "s5.sh5.p1": { "text": "Microsoft Foundry", "src": "ccb80b4a" },
    "s5.sh131.p1": { "text": "Eine einheitliche Plattform für KI-Apps und -Agents", "src": "04c0dca1" },
    "s5.sh130.p1": { "text": "Foundry-<i>Ressourcen</i> in Azure bieten Rechenleistung, Speicher, Modellbereitstellung und weitere Dienste", "src": "def6826b" },
    "s5.sh130.p2": { "text": "Foundry-<i>Projekte</i> sind isolierte Arbeitsumgebungen für die App- und Agentenentwicklung", "src": "7d9928ca" },
    "s5.sh130.p3": { "text": "In einem Projekt arbeiten Sie mit:", "src": "63a267fe" },
    "s5.sh130.p4": { "text": "<b>Modellen</b> – wählen Sie Modelle aus einem umfangreichen Modellkatalog aus und stellen Sie sie bereit", "src": "4c53e53a" },
    "s5.sh130.p5": { "text": "<b>Agenten</b> – erstellen und verwalten Sie Agenten, die Modelle für Sprachverarbeitung und logisches Denken nutzen", "src": "0ff8d083" },
    "s5.sh130.p6": { "text": "<b>Tools</b> – verbinden Sie Agenten mit Tools, damit sie Aktionen ausführen und auf Informationen zugreifen können", "src": "7eac46a1" },
    "s5.sh130.p7": { "text": "<b>Wissen</b> – verwalten Sie den Zugriff von Agenten auf Datenquellen, damit sie die Informationen erhalten, die sie zum Handeln benötigen", "src": "f1e79bfc" },
    "s5.sh83.p1": { "text": "", "src": "d642d845" },
    "s5.sh92.p1": { "text": "Modelle", "src": "01cd0fab" },
    "s5.sh95.p1": { "text": "Agenten", "src": "e7af956f" },
