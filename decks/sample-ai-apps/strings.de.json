    "s5.sh126.p1": { "text": "Microsoft Foundry-<i>Ressource</i>", "src": "cb67db2f" },
    "s5.sh127.p1": { "text": "Microsoft Foundry-<i>Projekt</i>", "src": "c5276194" },
    "s5.sh3.p1": { "text": "© Copyright Microsoft Corporation. Alle Rechte vorbehalten.", "src": "eb8425d5" },
    "s5.notes.p1": { "text": "Definieren Sie Foundry in einem Satz: „Foundry bietet Ihnen eine projektbasierte Arbeitsumgebung, in der Sie KI-Apps und -Agenten mit Modellen, Tools und Wissen an einem zentralen Ort entwickeln können.“", "src": "d82646c3" },
    "s5.notes.p2": { "text": "Betonen Sie das zugrunde liegende Konzept: <b>Ressourcen</b> stellen Dienste für Rechenleistung, Speicher und die Bereitstellung von Modellen bereit.", "src": "55564b5c" },
    "s5.notes.p3": { "text": "<b>Projekte</b> sind isolierte Arbeitsumgebungen für die App- &amp; Agentenentwicklung.", "src": "8e58c919" },
    "s5.notes.p4": { "text": "Innerhalb von Projekten: <b>Modelle</b>, <b>Agenten</b>, <b>Tools</b>, <b>Wissen</b>.", "src": "4d6ec164" },
    "s5.notes.p5": { "text": "Praktischer Hinweis: „Wenn die Lernenden den Überblick verlieren, verweisen Sie wieder auf diese Abbildung – die meisten Aufgaben lassen sich einem dieser vier Bereiche zuordnen.“", "src": "54027b8d" }
  }
