    {
      "id": "s5.sh131.p1",
      "slide": 5,
      "kind": "text",
      "text": "A unified platform for AI apps and agents",
      "context": "Microsoft Foundry"
    },
    {
      "id": "s5.sh130.p1",
      "slide": 5,
      "kind": "text",
      "text": "Foundry <i>resources</i> in Azure provide compute, storage, model delivery, and other services",
      "context": "Microsoft Foundry"
    },
    {
      "id": "s5.sh130.p2",
      "slide": 5,
      "kind": "text",
      "text": "Foundry <i>projects</i> are isolated work environments for app and agent development",
      "context": "Microsoft Foundry"
    },
    {
      "id": "s5.sh130.p3",
      "slide": 5,
      "kind": "text",
      "text": "In a project, you work with:",
      "context": "Microsoft Foundry"
    },
    {
      "id": "s5.sh130.p4",
      "slide": 5,
      "kind": "text",
      "text": "<b>Models</b> – choose and deploy models from an extensive model catalog",
      "context": "Microsoft Foundry"
    },
    {
      "id": "s5.sh130.p5",
      "slide": 5,
      "kind": "text",
      "text": "<b>Agents</b> – create and manage agents that use models for language and reasoning",
      "context": "Microsoft Foundry"
    },
    {
      "id": "s5.sh130.p6",
      "slide": 5,
      "kind": "text",
      "text": "<b>Tools</b> – connect agents to tools so they can perform actions and access information",
      "context": "Microsoft Foundry"
    },
    {
      "id": "s5.sh130.p7",
      "slide": 5,
      "kind": "text",
      "text": "<b>Knowledge</b> – manage data source access for agents so they have the information they need to act ",
      "context": "Microsoft Foundry"
    },
